[Unit]
Description=Kiosk Chromium Browser
After=default.target tv-boot-on.service
Wants=default.target

[Service]
Type=simple
Environment=DISPLAY=:0
Environment=XAUTHORITY=/home/pi/.Xauthority
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus
Environment=GNOME_KEYRING_CONTROL=
ExecStartPre=/bin/sleep 10
ExecStartPre=/usr/bin/xrandr --output HDMI-1 --rotate left
ExecStartPre=/usr/bin/xset s off -dpms
ExecStart=/usr/bin/chromium     --disable-gpu     --kiosk http://localhost     --noerrdialogs     --disable-infobars     --password-store=basic     --disable-session-crashed-bubble     --disable-features=TranslateUI     --check-for-update-interval=1     --simulate-critical-update
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
